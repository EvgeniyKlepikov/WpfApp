<Window x:Class="WpfAppCourse.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppCourse"
        mc:Ignorable="d"
        Title="Авторизация пользователя" Height="200" Width="300">
    <Grid>
        <TextBox Name="UsernameTextBox" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" Width="200" Height="30"/>
        <PasswordBox Name="PasswordBox" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0" Width="200" Height="30"/>
        <Button Name="loginButton" Content="Войти" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40" Width="100" Height="30" Click="loginButton_Click"/>
    </Grid>
</Window>
