<Window x:Class="WpfAppCourse.CarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:WpfAppCourse.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppCourse"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="550" Width="1000"
        Icon="pack://application:,,,/Images/Logo.jpg">
    <Window.Resources>
        <Style TargetType="Window">
            <Setter Property="Background" Value="Bisque"/>
        </Style>
        <Style TargetType="Grid">
            <Setter Property="Background" Value="DarkGoldenrod"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5,5,5,5"/>
            <Setter Property="Padding" Value="15,5,5,5"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="DarkGoldenrod"/>
            <Setter Property="BorderBrush" Value="Olive"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="Bisque"/>
            <Setter Property="BorderBrush" Value="Black"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <vm:CarWindowViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Список автомобилей" Margin="2" Padding="2" MinWidth="200" FontSize="18">
            <ListView x:Name="Cars" ItemsSource="{Binding Cars}"
                        SelectedValue="{Binding SelectedCar}" SelectedIndex="0">
                <!--#region Обработка события Selection Canged -->
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding GetDriversCommand}"
                                                   CommandParameter="{Binding SelectedCar.CarId}">
                        </i:InvokeCommandAction>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <!--#endregion-->
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding CarId}" FontSize="16"
                                               HorizontalAlignment="Left" Margin="30,0,0,0"/>
                                <TextBlock Text="{Binding CarName}" FontSize="16"
                                               HorizontalAlignment="Left" Margin="30,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <!--<TextBlock Text="{Binding CarName}"/>-->
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </GroupBox >
        <GroupBox Header="Параметры автомобиля" Grid.Column="1" Grid.ColumnSpan="2" FontSize="18">
            <!--#region Таблица -->
            <Grid DataContext="{Binding SelectedCar}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto" ></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="2*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock HorizontalAlignment="Right">Наименование:</TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CarName}" Background="LightGray"/>
                <TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right">Гос. Номер:</TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CarNumber}" Background="LightGray"/>
                <TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right">Грузоподъемность:</TextBlock>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CarWeight}" Background="LightGray"/>
            </Grid>
            <!--#endregion-->
        </GroupBox>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3">
            <!--<GroupBox Header="Список заявок" Width="550" DockPanel.Dock="Left" FontSize="14">
                <ListView x:Name="Drivers" ItemsSource="{Binding Drivers}"
                          SelectedItem="{Binding SelectedDriver}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    --><!--<ColumnDefinition Width="*"/>--><!--
                                </Grid.ColumnDefinitions>
                                --><!--<Image Width="50" Source="{Binding ImageFileName}"/>--><!--
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding DriverName}"
                                               HorizontalAlignment="Left" Margin="30,0,0,0"/>
                                    <TextBlock Text="{Binding DriverSurname}"
                                               HorizontalAlignment="Left" Margin="30,0,0,0"/>
                                    <TextBlock Text="{Binding DriverAge, StringFormat={}{0:0.0 лет}}"
                                               HorizontalAlignment="Left" Margin="30,0,0,0"/>
                                    <TextBlock Text="{Binding DateOfAdmission, StringFormat={}{0:dd.MM.yyyy дата отправки}}"
                                               HorizontalAlignment="Left" Margin="5,0,0,0"/>
                                    <TextBlock Text="{Binding DriverExperience}"
                                               Margin="5,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </GroupBox>-->
            <GroupBox Width="Auto" HorizontalAlignment="Right">
                <StackPanel >
                    <Button Command="{Binding NewCarCommand}">Добавить автомобиль</Button>
                    <Button Command="{Binding EditCarCommand}">Редактировать</Button>
                    <Button Command="{Binding DeleteCarCommand}">Удалить</Button>
                </StackPanel>
            </GroupBox>
        </DockPanel>
    </Grid>
</Window>

