<Window x:Class="WpfAppCourse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:WpfAppCourse.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppCourse"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="700" Width="1150">
    <Window.Resources>
        <Style TargetType="Window">
            <Setter Property="Background" Value="Bisque"/>
        </Style>
        <Style TargetType="Grid">
            <Setter Property="Background" Value="DarkGoldenrod"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5,5,5,5"/>
            <Setter Property="Padding" Value="15,5,5,5"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="DarkGoldenrod"/>
            <Setter Property="BorderBrush" Value="Olive"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="Bisque"/>
            <Setter Property="BorderBrush" Value="Black"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <GroupBox Grid.ColumnSpan="3" HorizontalAlignment="Left" Margin="2,2,0,2" Height="50">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding NewApplicationCommand}">Добавить заявку</Button>
                <Button Command="{Binding EditApplicationCommand}">Редактировать</Button>
                <Button Command="{Binding DeleteApplicationCommand}">Удалить</Button>
                <Button Command="{Binding DriverWindowCommand}">Водители</Button>
                <Button Command="{Binding CarWindowCommand}">Автомобили</Button>
                <Button Command="{Binding ClientWindowCommand}">Заказчики</Button>
                <Button Command="{Binding TechnicalStatusWindowCommand}">Осмотры</Button>
                <Button Command="{Binding RouteWindowCommand}">Маршруты</Button>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Список автомобилей" Margin="2" Padding="2" MinWidth="200" FontSize="16" Grid.Row="1">
            <ListView x:Name="Cars" ItemsSource="{Binding Cars}"
                        SelectedValue="{Binding SelectedCar}" SelectedIndex="0">
                <!--#region Обработка события Selection Canged -->
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding GetApplicationsCommand}"
                                                   CommandParameter="{Binding SelectedCar.CarId}">
                        </i:InvokeCommandAction>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <!--#endregion-->
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding CarName}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </GroupBox >
        <GroupBox Header="Калькулятор стоимости перевозки" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Grid.RowSpan="2" FontSize="16">
            <!--#region Таблица -->
            <!--<Grid DataContext="{Binding SelectedCar}">-->
            <Grid Height="450">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="2*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Grid.Row="0" Text="Масса груза (т):" FontSize="20"/>
                <TextBlock Grid.Column="0" Grid.Row="1" Text="Выберите маршрут:" FontSize="20"/>
                <TextBlock Grid.Column="0" Grid.Row="2" Text="Стоимость груза (руб):" FontSize="20"/>

                <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding Weight}" Margin="0,5,10,5" FontSize="22" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" Grid.Row="1" x:Name="ComboBoxRoutes" ItemsSource="{Binding Routes}"
                          DisplayMemberPath="Destination" SelectedValue="Distance" SelectedItem="{Binding SelectedRoute}" Margin="0,5,10,5" FontSize="20"/>
                <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding Cost}" Margin="0,5,10,5" FontSize="22" VerticalAlignment="Center"/>
                <Button Grid.Row="3" Grid.ColumnSpan="2" Command="{Binding GetCountOfTransferCommand}" Margin="110,20,110,1" FontSize="18">Рассчитать</Button>
                <TextBlock Grid.ColumnSpan="2" Grid.Row="4" Text="{Binding Greeting}" FontSize="20" TextAlignment="Center"/>
                <TextBlock Grid.Column="0" Grid.Row="5" Text="Выберите заказчика:" FontSize="20"/>
                <ComboBox Grid.Column="1" Grid.Row="5" x:Name="ComboBoxClients" ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}"
                          DisplayMemberPath="ClientSurname" Margin="0,5,10,5" FontSize="20"/>
                    <!--#region Обработка события Selection Canged -->
                    <!--<i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectionChanged">
                            <i:InvokeCommandAction Command="{Binding GetClientsCommand}"
                                                   CommandParameter="{Binding SelectedClient.ClientId}">
                            </i:InvokeCommandAction>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>-->
                    <!--#endregion-->
                <!--</ComboBox>-->
                <!--<TextBlock Grid.Column="0" Grid.Row="6" Text="Баланс заказчика (руб):" FontSize="20"/>
                <TextBlock Grid.Column="1" Grid.Row="6" Text="{Binding ClientSum}" Margin="0,5,10,5" FontSize="22" VerticalAlignment="Center"/>-->

                <Button Grid.Row="6" Grid.ColumnSpan="2" Command="{Binding GetPaymentCommand}" Margin="110,20,110,1" FontSize="18">Оплатить</Button>

                <!--<TextBlock Grid.ColumnSpan="2" Grid.Row="5" Text="{Binding Greeting2}" FontSize="20" TextAlignment="Center"/>-->

            </Grid>
            <!--#endregion-->
        </GroupBox>
        <!--<DockPanel Grid.Row="2" Grid.ColumnSpan="3">-->
            <GroupBox Grid.Row="2" Grid.Column="0" Header="Список заявок" DockPanel.Dock="Left" FontSize="16">
                <ListView x:Name="Applications" ItemsSource="{Binding Applications}"
                          SelectedItem="{Binding SelectedApplication}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <!--<ColumnDefinition Width="*"/>-->
                                </Grid.ColumnDefinitions>
                                <!--<Image Width="50" Source="{Binding ImageFileName}"/>-->
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding CargoName}"
                                               HorizontalAlignment="Left" Margin="30,0,0,0"/>
                                    <TextBlock Text="{Binding CargoWeight, StringFormat={}{0:0.0 тонн}}"
                                               HorizontalAlignment="Left" Margin="30,0,0,0"/>
                                    <TextBlock Text="{Binding DateOfDispatch, StringFormat={}{0:dd.MM.yyyy дата отправки}}"
                                               HorizontalAlignment="Left" Margin="5,0,0,0"/>
                                    <TextBlock Text="{Binding Destination}"
                                               Margin="5,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </GroupBox>
            <!--<GroupBox Width="Auto" HorizontalAlignment="Right">
                <StackPanel >
                    <Button Command="{Binding NewApplicationCommand}">Добавить заявку</Button>
                    <Button Command="{Binding EditApplicationCommand}">Редактировать</Button>
                    <Button Command="{Binding DeleteApplicationCommand}">Удалить</Button>
                    <Button Command="{Binding DriverWindowCommand}">Водители</Button>
                    <Button Command="{Binding CarWindowCommand}">Автомобили</Button>
                    <Button Command="{Binding ClientWindowCommand}">Заказчики</Button>
                    <Button Command="{Binding TechnicalStatusWindowCommand}">Осмотры</Button>
                    <Button Command="{Binding RouteWindowCommand}">Маршруты</Button>
                </StackPanel>
            </GroupBox>-->
        <!--</DockPanel>-->
    </Grid>
</Window>
