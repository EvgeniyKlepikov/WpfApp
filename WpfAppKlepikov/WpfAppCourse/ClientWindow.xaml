<Window x:Class="WpfAppCourse.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:WpfAppCourse.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppCourse"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="650" Width="1000"
        Icon="pack://application:,,,/Images/Logo.jpg">
    <Window.Resources>
        <Style TargetType="Window">
            <Setter Property="Background" Value="Bisque"/>
        </Style>
        <Style TargetType="Grid">
            <Setter Property="Background" Value="DarkGoldenrod"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5,5,5,5"/>
            <Setter Property="Padding" Value="15,5,5,5"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="DarkGoldenrod"/>
            <Setter Property="BorderBrush" Value="Olive"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="Bisque"/>
            <Setter Property="BorderBrush" Value="Black"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </Window.Resources>
    <Window.DataContext>
        <vm:ClientWindowViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Список автомобилей" Margin="2" Padding="2" MinWidth="200" FontSize="14" FontWeight="Bold">
            <ListView x:Name="Cars" ItemsSource="{Binding Cars}"
                        SelectedValue="{Binding SelectedCar}" SelectedIndex="0">
                <!--#region Обработка события Selection Canged -->
                <!--<i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding GetDriversCommand}"
                                                   CommandParameter="{Binding SelectedCar.CarId}">
                        </i:InvokeCommandAction>
                    </i:EventTrigger>
                </i:Interaction.Triggers>-->
                <!--#endregion-->
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding CarName}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </GroupBox >
        <GroupBox Header="Данные заказчика" Grid.Column="1" Grid.ColumnSpan="2" FontSize="14" FontWeight="Bold">
            <!--#region Таблица -->
            <Grid DataContext="{Binding SelectedClient}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="Auto" ></RowDefinition>
                    <!--<RowDefinition Height="Auto" ></RowDefinition>-->

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="2*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock HorizontalAlignment="Right" FontSize="16">Фамилия заказчика:</TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ClientSurname}" Background="LightGray"/>
                <TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" FontSize="16">Компания:</TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Company}" Background="LightGray"/>
                <TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right" FontSize="16">Баланс(руб):</TextBlock>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ClientDeposit}" Background="LightGray"/>
                <!--<TextBlock Grid.Row="3" Grid.Column="0" HorizontalAlignment="Right">Сумма пополнения:</TextBlock>-->
                <!--<TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Deposit}"/>-->

            </Grid>
            <!--<Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="2*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right">Сумма пополнения:</TextBlock>
                <TextBox Grid.Row="0" Grid.Column="1" Text="Deposit"/>

                --><!--<TextBox Text="{Binding Deposit}"/>--><!--
            </Grid>-->

            <!--<TextBox Text="{Binding Deposit}"/>-->

            <!--#endregion-->
        </GroupBox>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3">
            <GroupBox Header="Список заказчиков" Width="550" DockPanel.Dock="Left" FontSize="14" FontWeight="Bold">
                <ListView x:Name="Clients" ItemsSource="{Binding Clients}"
                    SelectedItem="{Binding SelectedClient}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>                                   
                                    <ColumnDefinition Width="*"/>            
                                </Grid.ColumnDefinitions>                                
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding ClientName}"
                                               HorizontalAlignment="Left" Margin="30,0,0,0"/>
                                    <TextBlock Text="{Binding ClientSurname}"
                                               HorizontalAlignment="Left" Margin="30,0,0,0"/>
                                    <TextBlock Text="{Binding Company, StringFormat={}{0:0.0 лет}}"
                                               HorizontalAlignment="Left" Margin="30,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </GroupBox>
            <GroupBox Width="Auto" HorizontalAlignment="Right">
                <StackPanel >
                    <Button Command="{Binding NewClientCommand}" FontSize="14" Margin="0,10,0,10">Добавить заказчика</Button>
                    <Button Command="{Binding EditClientCommand}" FontSize="14" Margin="0,0,0,10">Редактировать</Button>
                    <Button Command="{Binding DeleteClientCommand}" FontSize="14" Margin="0,0,0,10">Удалить</Button>
                    <Button Command="{Binding AddDepositCommand}" FontSize="14" Margin="0,20,0,10">Пополнить баланс</Button>
                    <TextBox Text="{Binding Deposit}" Height="31" Margin="5,0,5,0" FontSize="18"/>
                </StackPanel>
            </GroupBox>
        </DockPanel>
    </Grid>
</Window>
